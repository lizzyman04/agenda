migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
# Libraries should not include pubspec.lock, per https://dart.dev/guides/libraries/private-files#pubspec-lock.
/pubspec.lock
**/doc/api/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Jekyll landing site
landing/_site/
landing/.jekyll-cache/
landing/.sass-cache/
landing/Gemfile.lock

# Ephemeral GSD executor worktrees
.claude/worktrees/

# Isar Core native binary, downloaded on demand by
# Isar.initializeIsarCore(download: true) — see test/support/isar_test_harness.dart.
# `flutter test` resolves Platform.script to a synthetic repo-root entrypoint, so
# the binary is cached directly at the repo root, not under a build/ directory.
/libisar.so
/isar.dll
/libisar.dylib
